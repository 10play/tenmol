{
  "area": "scenes",
  "caps": ["local-backend", "webgl", "network"],
  "specs": [
    {
      "id": "scenes.header.add",
      "feature": "scenes",
      "label": "Scenes header ▸ + (store new scene)",
      "kind": "button",
      "requires": [],
      "note": "The + button runs cmd.scene('new','store',quiet=0); a new scene row/button appears.",
      "setup": [{ "do": "wait", "ms": 300 }],
      "trigger": [{ "do": "click", "selector": ".scpanel__head .scpanel__btn", "nth": 0 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scenes.header.previous",
      "feature": "scenes",
      "label": "Scenes header ▸ ‹ (previous scene)",
      "kind": "button",
      "requires": [],
      "note": "Recalls the previous scene; the 'current:' readout changes from F2 to F1.",
      "setup": [
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F2, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scpanel__head .scpanel__btn", "nth": 1 }],
      "settleMs": 700,
      "checks": [
        { "expect": "domChanged" },
        { "expect": "feedbackMatches", "pattern": "current:\\s*F1\\b" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.header.next",
      "feature": "scenes",
      "label": "Scenes header ▸ › (next scene)",
      "kind": "button",
      "requires": [],
      "note": "Recalls the next scene; after recalling F1 the readout advances to F2.",
      "setup": [
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F2, store" },
        { "do": "cmd", "text": "scene F1, recall" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scpanel__head .scpanel__btn", "nth": 2 }],
      "settleMs": 700,
      "checks": [
        { "expect": "domChanged" },
        { "expect": "feedbackMatches", "pattern": "current:\\s*F2\\b" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.header.sort",
      "feature": "scenes",
      "label": "Scenes header ▸ sort (cmd.scene_order '*', sort=1)",
      "kind": "button",
      "requires": [],
      "note": "Alphabetically reorders the scene bin; zzz/aaa stored out of order flip, changing the row order.",
      "setup": [
        { "do": "cmd", "text": "scene zzz, store" },
        { "do": "cmd", "text": "scene aaa, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scpanel__head .scpanel__btn", "nth": 3 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scenes.button.recall.left",
      "feature": "scenes",
      "label": "Scene button strip ▸ left-click recalls (PressMode 1)",
      "kind": "button",
      "requires": [],
      "note": "Left-click-release over the same button recalls that scene; the button gains is-current and the readout shows it.",
      "setup": [
        { "do": "cmd", "text": "set scene_buttons, 1" },
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F2, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scbar__btn[data-full-name=\"F1\"]" }],
      "settleMs": 700,
      "checks": [
        { "expect": "feedbackMatches", "pattern": "current:\\s*F1\\b" },
        { "expect": "selectorVisible", "selector": ".scbar__btn.is-current" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.button.browse.middle",
      "feature": "scenes",
      "label": "Scene button strip ▸ middle-drag rapid browse (PressMode 2)",
      "kind": "other",
      "requires": [],
      "note": "LIMITATION: middle-button press + drag ('rapid browse', Ctrl forces animate=0) cannot be driven by the audit DSL, which only issues left-clicks. This records the affordance's presence only.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "set scene_buttons, 1" },
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "hover", "selector": ".scbar__btn[data-full-name=\"F1\"]" }],
      "settleMs": 300,
      "checks": [{ "expect": "selectorVisible", "selector": ".scbar__btn" }]
    },
    {
      "id": "scenes.button.menu.right",
      "feature": "scenes",
      "label": "Scene button strip ▸ right-click opens pymol.menu.scene_menu",
      "kind": "other",
      "requires": ["remote-backend"],
      "note": "LIMITATION+BLOCKED: right-button press-release (no drag) calls menu.scene_menu, which is not ported by the local engine ('not ported by @tenmol/engine-ts yet'); and a right-click cannot be sent via the DSL. Requires the PyMOL bridge.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "set scene_buttons, 1" },
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "hover", "selector": ".scbar__btn[data-full-name=\"F1\"]" }],
      "settleMs": 300,
      "checks": [{ "expect": "selectorVisible", "selector": ".scbar__btn" }]
    },
    {
      "id": "scenes.button.reorder.drag",
      "feature": "scenes",
      "label": "Scene button strip ▸ drag to reorder (PressMode 3→4, cmd.scene_order)",
      "kind": "drag",
      "requires": [],
      "note": "LIMITATION: right-button drag across buttons emits per-row scene_order calls. A multi-button drag across overlapping absolute buttons is not expressible in the DSL; presence only.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "set scene_buttons, 1" },
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F2, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "hover", "selector": ".scbar__btn[data-full-name=\"F1\"]" }],
      "settleMs": 300,
      "checks": [{ "expect": "selectorVisible", "selector": ".scbar__btn" }]
    },
    {
      "id": "scenes.button.scroll.wheel",
      "feature": "scenes",
      "label": "Scene button strip ▸ wheel scrolls when list overflows (NSkip)",
      "kind": "other",
      "requires": [],
      "note": "LIMITATION: onWheel adjusts skip only when a scrollbar exists (list longer than n_disp). The DSL has no wheel action; presence only.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "set scene_buttons, 1" },
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "hover", "selector": ".scbar" }],
      "settleMs": 300,
      "checks": [{ "expect": "selectorVisible", "selector": ".scbar" }]
    },
    {
      "id": "scenes.row.select",
      "feature": "scenes",
      "label": "Scene Panel row ▸ single click selects",
      "kind": "button",
      "requires": [],
      "note": "Clicking a row sets it selected (is-selected).",
      "setup": [
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scpanel__rows .scrow", "nth": 0 }],
      "settleMs": 400,
      "checks": [{ "expect": "selectorVisible", "selector": ".scrow.is-selected" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scenes.row.recall.dblclick",
      "feature": "scenes",
      "label": "Scene Panel row ▸ double-click recalls (cmd.scene name,'recall')",
      "kind": "other",
      "requires": [],
      "note": "Double-clicking a row recalls it. The DSL has no dblclick primitive; two sequential real clicks are used and rely on the browser synthesising dblclick.",
      "setup": [
        { "do": "cmd", "text": "scene recalltest, store" },
        { "do": "cmd", "text": "scene othertest, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"recalltest\")" },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"recalltest\")" }
      ],
      "settleMs": 700,
      "checks": [
        { "expect": "feedbackMatches", "pattern": "current:\\s*recalltest\\b" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.row.rename.open",
      "feature": "scenes",
      "label": "Scene Panel row ▸ double-click name opens inline editor",
      "kind": "other",
      "requires": [],
      "note": "Double-clicking the name button opens the inline rename TextInput. Two sequential clicks stand in for the dblclick primitive the DSL lacks.",
      "setup": [
        { "do": "cmd", "text": "scene renopen, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renopen\") .scrow__name" },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renopen\") .scrow__name" }
      ],
      "settleMs": 500,
      "checks": [{ "expect": "selectorVisible", "selector": ".scrow__rename" }]
    },
    {
      "id": "scenes.row.rename.valid",
      "feature": "scenes",
      "label": "Scene Panel row ▸ rename to a valid name commits (Enter)",
      "kind": "input",
      "requires": [],
      "note": "Typing a valid name and pressing Enter runs cmd.scene(old,'rename',new_key=...); the editor closes and the new name shows.",
      "setup": [
        { "do": "cmd", "text": "scene renval, store" },
        { "do": "wait", "ms": 1700 },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renval\") .scrow__name" },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renval\") .scrow__name" },
        { "do": "waitFor", "selector": ".scrow__rename", "ms": 3000 }
      ],
      "trigger": [
        { "do": "type", "selector": ".scrow__rename", "text": "renamedok" },
        { "do": "press", "key": "Enter", "selector": ".scrow__rename" }
      ],
      "settleMs": 700,
      "checks": [
        { "expect": "selectorHidden", "selector": ".scrow__rename" },
        { "expect": "feedbackMatches", "pattern": "renamedok" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.row.rename.space",
      "feature": "scenes",
      "label": "Scene Panel row ▸ rename with a space is rejected inline",
      "kind": "input",
      "requires": [],
      "note": "'a b' is refused (scene_order is a space-separated list) with a visible reason; no rename call is made.",
      "setup": [
        { "do": "cmd", "text": "scene renspace, store" },
        { "do": "wait", "ms": 1700 },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renspace\") .scrow__name" },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renspace\") .scrow__name" },
        { "do": "waitFor", "selector": ".scrow__rename", "ms": 3000 }
      ],
      "trigger": [
        { "do": "type", "selector": ".scrow__rename", "text": "a b" },
        { "do": "press", "key": "Enter", "selector": ".scrow__rename" }
      ],
      "settleMs": 500,
      "checks": [
        { "expect": "selectorVisible", "selector": ".scrow__renameerr" },
        { "expect": "feedbackMatches", "pattern": "cannot contain spaces" }
      ]
    },
    {
      "id": "scenes.row.rename.blank",
      "feature": "scenes",
      "label": "Scene Panel row ▸ rename to blank is rejected inline",
      "kind": "input",
      "requires": [],
      "note": "An empty name is refused with 'a scene name cannot be blank'; no rename call is made.",
      "setup": [
        { "do": "cmd", "text": "scene renblank, store" },
        { "do": "wait", "ms": 1700 },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renblank\") .scrow__name" },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renblank\") .scrow__name" },
        { "do": "waitFor", "selector": ".scrow__rename", "ms": 3000 }
      ],
      "trigger": [
        { "do": "type", "selector": ".scrow__rename", "text": "" },
        { "do": "press", "key": "Enter", "selector": ".scrow__rename" }
      ],
      "settleMs": 500,
      "checks": [
        { "expect": "selectorVisible", "selector": ".scrow__renameerr" },
        { "expect": "feedbackMatches", "pattern": "cannot be blank" }
      ]
    },
    {
      "id": "scenes.row.rename.escape",
      "feature": "scenes",
      "label": "Scene Panel row ▸ Escape cancels the rename editor",
      "kind": "input",
      "requires": [],
      "note": "Escape closes the inline editor without renaming.",
      "setup": [
        { "do": "cmd", "text": "scene renesc, store" },
        { "do": "wait", "ms": 1700 },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renesc\") .scrow__name" },
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"renesc\") .scrow__name" },
        { "do": "waitFor", "selector": ".scrow__rename", "ms": 3000 }
      ],
      "trigger": [{ "do": "press", "key": "Escape", "selector": ".scrow__rename" }],
      "settleMs": 400,
      "checks": [{ "expect": "selectorHidden", "selector": ".scrow__rename" }]
    },
    {
      "id": "scenes.row.message",
      "feature": "scenes",
      "label": "Scene Panel row ▸ message field (cmd.set_scene_message)",
      "kind": "input",
      "requires": [],
      "note": "Typing in the message input calls cmd.set_scene_message (ported locally) without error. NOTE: the display round-trip needs get_scene_panel (bridge-only), so the fallback shows an empty value; this asserts the write does not throw.",
      "setup": [
        { "do": "cmd", "text": "scene msgtest, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [
        { "do": "type", "selector": ".scpanel__rows .scrow:has-text(\"msgtest\") .scrow__message", "text": "hello world" }
      ],
      "settleMs": 600,
      "checks": [{ "expect": "noConsoleError" }]
    },
    {
      "id": "scenes.row.update",
      "feature": "scenes",
      "label": "Scene Panel row ▸ upd (cmd.scene name,'update')",
      "kind": "button",
      "requires": [],
      "note": "Updates the stored scene to the current view; must not throw and the row remains.",
      "setup": [
        { "do": "cmd", "text": "scene updtest, store" },
        { "do": "cmd", "text": "scene updtest, recall" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"updtest\") .scrow__ops button", "nth": 0 }
      ],
      "settleMs": 600,
      "checks": [
        { "expect": "selectorVisible", "selector": ".scpanel__rows .scrow:has-text(\"updtest\")" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.row.delete",
      "feature": "scenes",
      "label": "Scene Panel row ▸ del (cmd.scene name,'clear')",
      "kind": "button",
      "requires": [],
      "note": "Deletes the scene; the row disappears.",
      "setup": [
        { "do": "cmd", "text": "scene deltest, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [
        { "do": "click", "selector": ".scpanel__rows .scrow:has-text(\"deltest\") .scrow__ops button", "nth": 1 }
      ],
      "settleMs": 700,
      "checks": [
        { "expect": "selectorHidden", "selector": ".scpanel__rows .scrow:has-text(\"deltest\")" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scenes.row.handle.keyboard",
      "feature": "scenes",
      "label": "Scene Panel row ▸ drag handle keyboard reorder (ArrowDown)",
      "kind": "keyboard",
      "requires": [],
      "note": "ArrowDown on the reorder handle moves the scene one slot down via cmd.scene_order; the row order changes.",
      "setup": [
        { "do": "cmd", "text": "scene hkA, store" },
        { "do": "cmd", "text": "scene hkB, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [
        { "do": "press", "key": "ArrowDown", "selector": ".scpanel__rows .scrow:has-text(\"hkA\") .scrow__handle" }
      ],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scenes.row.handle.drag",
      "feature": "scenes",
      "label": "Scene Panel row ▸ drag handle pointer reorder",
      "kind": "drag",
      "requires": [],
      "note": "LIMITATION: a pointer-capture drag of the handle across rows (issuing one cmd.scene_order on release) is not expressible in the DSL; presence only. Keyboard equivalent is covered by scenes.row.handle.keyboard.",
      "setup": [
        { "do": "cmd", "text": "scene hdA, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "hover", "selector": ".scrow__handle", "nth": 0 }],
      "settleMs": 300,
      "checks": [{ "expect": "selectorVisible", "selector": ".scrow__handle" }]
    },
    {
      "id": "scmenu.previous",
      "feature": "scenes",
      "label": "Scene menu ▸ Previous [PgUp]",
      "kind": "button",
      "requires": [],
      "note": "Recalls the previous scene.",
      "setup": [
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F2, store" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 0 }],
      "settleMs": 700,
      "checks": [
        { "expect": "feedbackMatches", "pattern": "current:\\s*F1\\b" },
        { "expect": "domChanged" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scmenu.next",
      "feature": "scenes",
      "label": "Scene menu ▸ Next [PgDn]",
      "kind": "button",
      "requires": [],
      "note": "Recalls the next scene.",
      "setup": [
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F2, store" },
        { "do": "cmd", "text": "scene F1, recall" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 1 }],
      "settleMs": 700,
      "checks": [
        { "expect": "feedbackMatches", "pattern": "current:\\s*F2\\b" },
        { "expect": "domChanged" },
        { "expect": "noConsoleError" }
      ]
    },
    {
      "id": "scmenu.append",
      "feature": "scenes",
      "label": "Scene menu ▸ Append (store new)",
      "kind": "button",
      "requires": [],
      "note": "Stores a new scene at the end; a new row appears.",
      "setup": [{ "do": "wait", "ms": 300 }],
      "trigger": [{ "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 2 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scmenu.append.submenu",
      "feature": "scenes",
      "label": "Scene menu ▸ Append… opens the flag submenu",
      "kind": "menu-open",
      "requires": [],
      "note": "Toggles open the Camera/Color/Reps/Reps+Color submenu.",
      "setup": [{ "do": "wait", "ms": 200 }],
      "trigger": [{ "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 3 }],
      "settleMs": 400,
      "checks": [{ "expect": "selectorVisible", "selector": ".scmenu__sub button:has-text(\"Camera\")" }]
    },
    {
      "id": "scmenu.append.camera",
      "feature": "scenes",
      "label": "Scene menu ▸ Append… ▸ Camera",
      "kind": "menu-command",
      "requires": [],
      "note": "Runs 'scene new, store, color=0, rep=0' (camera-only store); a new scene is added.",
      "setup": [
        { "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 3 },
        { "do": "waitFor", "selector": ".scmenu__sub button:has-text(\"Camera\")", "ms": 3000 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu__sub button", "nth": 0 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scmenu.append.color",
      "feature": "scenes",
      "label": "Scene menu ▸ Append… ▸ Color",
      "kind": "menu-command",
      "requires": [],
      "note": "Runs 'scene new, store, view=0, rep=0' (color-only store).",
      "setup": [
        { "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 3 },
        { "do": "waitFor", "selector": ".scmenu__sub button:has-text(\"Camera\")", "ms": 3000 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu__sub button", "nth": 1 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scmenu.append.reps",
      "feature": "scenes",
      "label": "Scene menu ▸ Append… ▸ Reps",
      "kind": "menu-command",
      "requires": [],
      "note": "Runs 'scene new, store, view=0, color=0' (reps-only store).",
      "setup": [
        { "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 3 },
        { "do": "waitFor", "selector": ".scmenu__sub button:has-text(\"Camera\")", "ms": 3000 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu__sub button", "nth": 2 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scmenu.append.repscolor",
      "feature": "scenes",
      "label": "Scene menu ▸ Append… ▸ Reps + Color",
      "kind": "menu-command",
      "requires": [],
      "note": "Runs 'scene new, store, view=0' (reps+color store).",
      "setup": [
        { "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 3 },
        { "do": "waitFor", "selector": ".scmenu__sub button:has-text(\"Camera\")", "ms": 3000 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu__sub button", "nth": 3 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scmenu.insertbefore",
      "feature": "scenes",
      "label": "Scene menu ▸ Insert Before",
      "kind": "button",
      "requires": [],
      "note": "Stores a new scene and orders it before the current one; a new row appears.",
      "setup": [
        { "do": "cmd", "text": "scene F1, store" },
        { "do": "cmd", "text": "scene F1, recall" },
        { "do": "wait", "ms": 1700 }
      ],
      "trigger": [{ "do": "click", "selector": ".scmenu .scmenu__row button", "nth": 4 }],
      "settleMs": 700,
      "checks": [{ "expect": "domChanged" }, { "expect": "noConsoleError" }]
    },
    {
      "id": "scmenu.insertafter",
      "feature": "scenes",
