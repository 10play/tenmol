      "checks": [
        { "expect": "feedbackMatches", "pattern": "2-Button Lights" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.butmode.mode.cycle-forward",
      "feature": "mouse",
      "label": "ButMode mode line ▸ left-click cycles mode forward",
      "kind": "button",
      "requires": [],
      "note": "onMouseDown(cycleMode) with a plain left button issues cmd.mouse('forward'), stepping the ring; the printed mode name changes on re-read.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 500 }
      ],
      "trigger": [
        { "do": "click", "selector": "[data-testid=\"butmode-mode\"]" },
        { "do": "wait", "ms": 500 }
      ],
      "checks": [
        { "expect": "domChanged" },
        { "expect": "feedbackMatches", "pattern": "3-Button Editing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 700
    },
    {
      "id": "mouse.butmode.selection.cycle-forward",
      "feature": "mouse",
      "label": "ButMode selection line ▸ left-click cycles level forward",
      "kind": "button",
      "requires": [],
      "note": "In a viewing mode single-left is not pkat, so the bottom line cycles: left-click issues cmd.mouse('select_forward'); from Molecules(5) it advances to C-alphas(6).",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "cmd", "text": "set mouse_selection_mode, 5" },
        { "do": "wait", "ms": 500 }
      ],
      "trigger": [
        { "do": "click", "selector": "[data-testid=\"butmode-selection\"]" },
        { "do": "wait", "ms": 500 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "C-alphas" },
        { "expect": "domChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 700
    },
    {
      "id": "mouse.butmode.selection.level-reflect",
      "feature": "mouse",
      "label": "ButMode selection line reflects mouse_selection_mode",
      "kind": "other",
      "requires": [],
      "note": "Setting mouse_selection_mode, 3 makes the bottom line read 'Selecting Segments' (SELECTION_LEVELS[3]).",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 300 }
      ],
      "trigger": [
        { "do": "cmd", "text": "set mouse_selection_mode, 3" },
        { "do": "wait", "ms": 600 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "Segments" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.butmode.editing.picking-line",
      "feature": "mouse",
      "label": "ButMode selection line shows 'Picking Atoms' + is disabled in editing mode",
      "kind": "other",
      "requires": [],
      "note": "When single-left resolves to pkat (editing modes), selectionLine() returns 'Picking Atoms (and Joints)' and the line is rendered disabled (does not cycle).",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "config_mouse three_button_editing" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "Picking Atoms" },
        { "expect": "selectorVisible", "selector": "[data-testid=\"butmode-selection\"][disabled]" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.butmode.grid.show",
      "feature": "mouse",
      "label": "ButMode 5-char action grid appears when mouse_grid is set",
      "kind": "toggle",
      "requires": [],
      "note": "The grid (data-testid=butmode-grid) is drawn only while mouse_grid is on; it shows the 'Buttons L M R Wheel' header and six labelled rows (& Keys, Shft, Ctrl, CtSh, SnglClk, DblClk).",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 300 }
      ],
      "trigger": [
        { "do": "cmd", "text": "set mouse_grid, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-grid\"]", "ms": 6000 }
      ],
      "checks": [
        { "expect": "selectorVisible", "selector": "[data-testid=\"butmode-grid\"]" },
        { "expect": "feedbackMatches", "pattern": "Buttons" },
        { "expect": "feedbackMatches", "pattern": "Wheel" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.butmode.grid.click-cycle",
      "feature": "mouse",
      "label": "ButMode grid ▸ left-click cycles mode (like any line above the last two)",
      "kind": "button",
      "requires": [],
      "note": "The grid shares the cycleMode handler; a plain left-click issues cmd.mouse('forward') and the mode name changes.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "set mouse_grid, 1" },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-grid\"]", "ms": 6000 },
        { "do": "wait", "ms": 400 }
      ],
      "trigger": [
        { "do": "click", "selector": "[data-testid=\"butmode-grid\"]" },
        { "do": "wait", "ms": 500 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Editing" },
        { "expect": "domChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 700
    },
    {
      "id": "mouse.butmode.mode.rightclick-menu",
      "feature": "mouse",
      "label": "ButMode mode line ▸ right-click opens the mouse_config pop-up",
      "kind": "other",
      "requires": [],
      "note": "LIMITATION: the audit DSL's click is left-button only, so button-2 cannot be issued and the pymolMenu pop-up (rows: 3-Button Motions … 2-Button Lights) cannot be opened here. The nine leaf commands are each exercised directly by the mouse.config.* specs. This spec only asserts the block does not throw when clicked.",
      "needsVisual": true,
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "hover", "selector": "[data-testid=\"butmode-mode\"]" }
      ],
      "checks": [
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.butmode.mode.shiftclick-reverse",
      "feature": "mouse",
      "label": "ButMode mode line ▸ Shift-click cycles backward",
      "kind": "other",
      "requires": [],
      "note": "LIMITATION: the DSL cannot hold Shift during a click, so the isForward() inversion (cmd.mouse('backward')) cannot be driven deterministically. Recorded for inventory completeness; hover-only smoke check.",
      "needsVisual": true,
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "hover", "selector": "[data-testid=\"butmode-mode\"]" }
      ],
      "checks": [
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.butmode.selection.rightclick-reverse",
      "feature": "mouse",
      "label": "ButMode selection line ▸ right-click cycles level BACKWARD (no menu)",
      "kind": "other",
      "requires": [],
      "note": "LIMITATION: button-2 is not issuable by the DSL. Behaviour under test (per ButMode.cpp:163-173 and p8a2butmode.dom.test): a right-click on the bottom line issues cmd.mouse('select_backward') and does NOT open mouse_config. Hover-only smoke check here.",
      "needsVisual": true,
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 400 }
      ],
      "trigger": [
        { "do": "hover", "selector": "[data-testid=\"butmode-selection\"]" }
      ],
      "checks": [
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.butmode.wheel-cycle",
      "feature": "mouse",
      "label": "ButMode ▸ mouse-wheel over the block cycles the mode",
      "kind": "other",
      "requires": [],
      "note": "LIMITATION: the DSL has no wheel action, so onWheel (deltaY>0 → backward, deltaY<0 → forward, Shift inverts) cannot be driven. Recorded for inventory completeness; hover-only smoke check.",
      "needsVisual": true,
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "hover", "selector": "[data-testid=\"butmode\"]" }
      ],
      "checks": [
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.config-panel.open",
      "feature": "mouse",
      "label": "Mouse & Keys… button opens the mouse configuration matrix",
      "kind": "button",
      "requires": [],
      "note": "The butmode-config button sets panel='mouse', rendering the MouseConfigPanel inside the [data-testid=mouse-config] dialog with the title 'Mouse configuration'.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-config\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "click", "selector": "[data-testid=\"butmode-config\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"mouse-config\"]", "ms": 6000 }
      ],
      "checks": [
        { "expect": "selectorVisible", "selector": "[data-testid=\"mouse-config\"]" },
        { "expect": "feedbackMatches", "pattern": "Mouse configuration" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 500
    },
    {
      "id": "mouse.config-panel.header-mode",
      "feature": "mouse",
      "label": "Mouse config header shows the live mode_dict key",
      "kind": "other",
      "requires": [],
      "note": "The panel header prints 'Mouse configuration — 3-Button Viewing (three_button_viewing)'; the mode key is read live from useMouseMode.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-config\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 500 },
        { "do": "click", "selector": "[data-testid=\"butmode-config\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"mouse-config\"]", "ms": 6000 }
      ],
      "trigger": [
        { "do": "wait", "ms": 300 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "three_button_viewing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.config-panel.note-80slots",
      "feature": "mouse",
      "label": "Mouse config honesty note (80 slots / no reader) renders",
      "kind": "other",
      "requires": [],
      "note": "The panel's note explains the matrix is 8 modifiers x 10 buttons = 80 slots and that PyMOL exposes no reader for the table.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-config\"]", "ms": 8000 },
        { "do": "click", "selector": "[data-testid=\"butmode-config\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"mouse-config\"]", "ms": 6000 }
