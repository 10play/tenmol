{
  "area": "mouse",
  "caps": ["local-backend", "webgl", "network"],
  "specs": [
    {
      "id": "mouse.internal-gui.enable",
      "feature": "mouse",
      "label": "Enable internal_gui → ButMode block mounts",
      "kind": "toggle",
      "requires": [],
      "note": "`set internal_gui, 1` turns on the right-hand column; ShortcutsService portals the ButMode block (data-testid=butmode) into it, printing 'Mouse Mode <name>'.",
      "setup": [],
      "trigger": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "checks": [
        { "expect": "selectorVisible", "selector": "[data-testid=\"butmode\"]" },
        { "expect": "selectorVisible", "selector": "[data-testid=\"butmode-mode\"]" },
        { "expect": "selectorVisible", "selector": "[data-testid=\"butmode-name\"]" },
        { "expect": "feedbackMatches", "pattern": "Mouse Mode" }
      ],
      "settleMs": 1200
    },
    {
      "id": "mouse.butmode.mode-name-reflect",
      "feature": "mouse",
      "label": "ButMode name reflects cmd.mouse(three_button_viewing)",
      "kind": "other",
      "requires": [],
      "note": "useMouseMode polls button_mode_name at 4Hz; after `mouse three_button_viewing` the block prints '3-Button Viewing'.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Viewing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.three_button_motions",
      "feature": "mouse",
      "label": "mouse_config ▸ 3-Button Motions (config_mouse three_button_motions)",
      "kind": "menu-command",
      "requires": [],
      "note": "First entry of the mouse_config pop-up (MOUSE_CONFIG_MENU). Its command config_mouse('three_button_motions') sets the ring; button_mode_name resolves to '3-Button Motions'. The pop-up itself opens only on right-click (see mouse.butmode.mode.rightclick-menu); this drives the leaf's command directly.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "config_mouse three_button_motions" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Motions" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.three_button_editing",
      "feature": "mouse",
      "label": "mouse_config ▸ 3-Button Editing (config_mouse three_button_editing)",
      "kind": "menu-command",
      "requires": [],
      "note": "Second mouse_config leaf. config_mouse('three_button_editing') → name '3-Button Editing'; single-left binds pkat.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "config_mouse three_button_editing" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Editing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.three_button_viewing",
      "feature": "mouse",
      "label": "mouse_config ▸ 3-Button Viewing (mouse three_button_viewing)",
      "kind": "menu-command",
      "requires": [],
      "note": "Third mouse_config leaf. It calls cmd.mouse('three_button_viewing') (a mode OUTSIDE the ring), not config_mouse → name '3-Button Viewing'.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "config_mouse three_button_editing" },
        { "do": "wait", "ms": 400 }
      ],
      "trigger": [
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Viewing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.three_button_lights",
      "feature": "mouse",
      "label": "mouse_config ▸ 3-Button Lights (mouse three_button_lights)",
      "kind": "menu-command",
      "requires": [],
      "note": "Fourth mouse_config leaf. cmd.mouse('three_button_lights') → name '3-Button Lights'.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "mouse three_button_lights" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Lights" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.three_button_all_modes",
      "feature": "mouse",
      "label": "mouse_config ▸ 3-Button All Modes (config_mouse three_button_all_modes)",
      "kind": "menu-command",
      "requires": [],
      "note": "Fifth mouse_config leaf. config_mouse('three_button_all_modes') selects a 4-mode ring whose first entry is three_button_editing, so button_mode_name resolves to '3-Button Editing' (documented ring resolution, controlling.py).",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_lights" },
        { "do": "wait", "ms": 400 }
      ],
      "trigger": [
        { "do": "cmd", "text": "config_mouse three_button_all_modes" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "3-Button Editing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.two_button_editing",
      "feature": "mouse",
      "label": "mouse_config ▸ 2-Button Editing (config_mouse two_button_editing)",
      "kind": "menu-command",
      "requires": [],
