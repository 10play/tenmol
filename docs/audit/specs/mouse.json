        { "expect": "feedbackMatches", "pattern": "no reader" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.config-panel.cell.value-reflect",
      "feature": "mouse",
      "label": "Mouse config cell left/none reads the mode's binding (Rota)",
      "kind": "other",
      "requires": [],
      "note": "In a viewing mode the left/none slot binds 'rota', so the cell-left/none dropdown shows the 'Rota' action.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-config\"]", "ms": 8000 },
        { "do": "cmd", "text": "mouse three_button_viewing" },
        { "do": "wait", "ms": 500 },
        { "do": "click", "selector": "[data-testid=\"butmode-config\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"mouse-config\"]", "ms": 6000 }
      ],
      "trigger": [
        { "do": "waitFor", "selector": "[data-testid=\"cell-left/none\"]", "ms": 6000 }
      ],
      "checks": [
        { "expect": "selectorVisible", "selector": "[data-testid=\"cell-left/none\"]" },
        { "expect": "feedbackMatches", "pattern": "Rota" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },
    {
      "id": "mouse.config-panel.cell.change-undrivable",
      "feature": "mouse",
      "label": "Mouse config cell dropdown ▸ selecting an action issues cmd.button",
      "kind": "input",
      "requires": [],
      "note": "LIMITATION: each cell is a native <select>; the audit DSL has no select-option action, so changing a binding (which fires write() → cmd.button(button,modifier,action)) cannot be driven. Additionally there is no ButModeGet reader, so an externally issued `button` cmd would not visibly update the cell. Recorded for inventory; asserts the control renders and is interactive.",
      "needsVisual": true,
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode-config\"]", "ms": 8000 },
        { "do": "click", "selector": "[data-testid=\"butmode-config\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"mouse-config\"]", "ms": 6000 }
      ],
      "trigger": [
        { "do": "hover", "selector": "[data-testid=\"cell-left/none\"]" }
      ],
      "checks": [
        { "expect": "selectorVisible", "selector": "[data-testid=\"cell-left/none\"]" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
