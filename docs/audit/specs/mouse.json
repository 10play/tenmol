      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "config_mouse two_button_editing" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "2-Button Editing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.two_button_viewing",
      "feature": "mouse",
      "label": "mouse_config ▸ 2-Button Viewing (config_mouse two_button_viewing)",
      "kind": "menu-command",
      "requires": [],
      "note": "Eighth mouse_config leaf. config_mouse('two_button_viewing') → name '2-Button Viewing'.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "config_mouse two_button_viewing" },
        { "do": "wait", "ms": 700 }
      ],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "2-Button Viewing" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "mouse.config.two_button_lights",
      "feature": "mouse",
      "label": "mouse_config ▸ 2-Button Lights (mouse two_button_lights)",
      "kind": "menu-command",
      "requires": [],
      "note": "Ninth (last) mouse_config leaf. cmd.mouse('two_button_lights') → name '2-Button Lights'.",
      "setup": [
        { "do": "cmd", "text": "set internal_gui, 1" },
        { "do": "waitFor", "selector": "[data-testid=\"butmode\"]", "ms": 8000 }
      ],
      "trigger": [
        { "do": "cmd", "text": "mouse two_button_lights" },
        { "do": "wait", "ms": 700 }
