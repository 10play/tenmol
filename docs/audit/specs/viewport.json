    {
      "id": "viewport.canvas.rotate.drag",
      "feature": "viewport",
      "label": "Canvas left-drag rotate",
      "kind": "drag",
      "requires": [],
      "note": "Left-button pointer drag on the viewport host rotates the camera (client-side viewSync in local mode). The audit DSL has no drag primitive, so this cannot be driven end-to-end; the deterministic camera behaviour is covered by viewport.render.turn.*. Here we only verify hovering the canvas is inert (no error). LIMITATION: free 3D mouse-drag is not scriptable.",
      "needsVisual": true,
      "setup": [{ "do": "waitFor", "selector": ".viewport__host" }],
      "trigger": [{ "do": "hover", "selector": ".viewport__host" }],
      "checks": [{ "expect": "noConsoleError" }],
      "settleMs": 300
    },
    {
      "id": "viewport.canvas.translate.drag",
      "feature": "viewport",
      "label": "Canvas middle/right-drag translate",
      "kind": "drag",
      "requires": [],
      "note": "Middle/right-button (or shift+left) pointer drag pans/translates the camera. Not scriptable via the audit DSL; hovering is verified inert. LIMITATION: free 3D mouse-drag is not scriptable.",
      "needsVisual": true,
      "setup": [{ "do": "waitFor", "selector": ".viewport__host" }],
      "trigger": [{ "do": "hover", "selector": ".viewport__host" }],
      "checks": [{ "expect": "noConsoleError" }],
      "settleMs": 300
    },
    {
      "id": "viewport.canvas.zoom.wheel",
      "feature": "viewport",
      "label": "Canvas wheel zoom",
      "kind": "other",
      "requires": [],
      "note": "Mouse wheel over the canvas is forwarded as a two-frame down/up input to change zoom (and trackpad pinch via ctrl+wheel). The audit DSL has no wheel primitive; hovering is verified inert. LIMITATION: wheel/pinch is not scriptable here.",
      "needsVisual": true,
      "setup": [{ "do": "waitFor", "selector": ".viewport__host" }],
      "trigger": [{ "do": "hover", "selector": ".viewport__host" }],
      "checks": [{ "expect": "noConsoleError" }],
      "settleMs": 300
    },
    {
      "id": "viewport.canvas.pick.click",
      "feature": "viewport",
      "label": "Canvas click atom pick",
      "kind": "other",
      "requires": ["picking"],
      "note": "A plain left click (no drag) on the canvas picks the atom under the cursor. Backend/offscreen picking is unavailable in the audit environment, so this is recorded BLOCKED rather than driven.",
      "needsVisual": true,
      "setup": [{ "do": "waitFor", "selector": ".viewport__host" }],
      "trigger": [{ "do": "click", "selector": ".viewport__host" }],
      "checks": [
        { "expect": "domChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 400
    },

    {
      "id": "viewport.hud.toggle.collapse",
      "feature": "viewport",
      "label": "HUD collapse (× button)",
      "kind": "toggle",
      "requires": [],
      "note": "Clicking the HUD toggle when open (shows ×) collapses the diagnostics panel; the rep toggles and stat lines should disappear, leaving only the small toggle handle.",
      "needsVisual": false,
      "setup": [{ "do": "waitFor", "selector": ".viewport__hud-toggle" }],
      "trigger": [{ "do": "click", "selector": ".viewport__hud-toggle" }],
      "checks": [
        { "expect": "selectorHidden", "selector": ".viewport__hud-reps" },
        { "expect": "selectorHidden", "selector": ".viewport__hud-line" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 300
    },
    {
      "id": "viewport.hud.toggle.expand",
      "feature": "viewport",
      "label": "HUD expand (i button)",
      "kind": "toggle",
      "requires": [],
      "note": "Following the collapse spec the HUD is closed (shows i); clicking the toggle re-opens it, restoring the stat lines and rep toggles. Leaves the HUD open for subsequent runs.",
      "needsVisual": false,
      "setup": [{ "do": "waitFor", "selector": ".viewport__hud-toggle" }],
      "trigger": [{ "do": "click", "selector": ".viewport__hud-toggle" }],
      "checks": [
        { "expect": "selectorVisible", "selector": ".viewport__hud-reps" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 300
