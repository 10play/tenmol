      "id": "viewport.render.bgColor",
      "feature": "viewport",
      "label": "Viewport reflects background colour change",
      "kind": "other",
      "requires": [],
      "note": "`bg_color white` changes the scene background; the viewport canvas must repaint with the new clear colour.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "as cartoon" },
        { "do": "wait", "ms": 500 }
      ],
