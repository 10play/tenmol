{
  "area": "viewport",
  "caps": ["local-backend", "webgl", "network"],
  "specs": [
    {
      "id": "viewport.hud.stats",
      "feature": "viewport",
      "label": "HUD diagnostics readout",
      "kind": "other",
      "requires": [],
      "note": "The always-open diagnostics HUD renders live render-loop stats (dimensions, fps, Mode P / Mode G frame counters). Its presence proves the viewport render loop is running and stats are polling.",
      "needsVisual": false,
      "setup": [{ "do": "waitFor", "selector": ".viewport__hud-reps" }],
      "trigger": [{ "do": "wait", "ms": 300 }],
      "checks": [
        { "expect": "feedbackMatches", "pattern": "fps" },
        { "expect": "feedbackMatches", "pattern": "Mode G" },
        { "expect": "selectorVisible", "selector": ".viewport__hud-reps" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 300
    },

    {
      "id": "viewport.rep.cartoon.pixel",
      "feature": "viewport",
      "label": "Cartoon ▸ P (Mode P / server-rendered)",
      "kind": "toggle",
      "requires": [],
      "note": "With cartoon shown as client-side Mode-G geometry, clicking its P button switches the rep to server-rendered Mode P. The audit backend has no pixel source, so the cartoon geometry should vanish from the canvas — a visible render mutation.",
      "needsVisual": true,
      "setup": [
        { "do": "waitFor", "selector": ".viewport__hud-reps" },
        { "do": "cmd", "text": "as cartoon" },
        { "do": "wait", "ms": 700 }
      ],
      "trigger": [{ "do": "click", "selector": ".viewport__hud-rep button", "nth": 0 }],
      "checks": [
        { "expect": "screenshotChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },
    {
      "id": "viewport.rep.cartoon.geometry",
      "feature": "viewport",
      "label": "Cartoon ▸ G (Mode G / client three.js)",
      "kind": "toggle",
      "requires": [],
      "note": "From Mode P (blank, no pixel source), clicking the cartoon G button switches back to client-side Mode-G geometry; the cartoon should re-appear on the canvas.",
      "needsVisual": true,
      "setup": [
        { "do": "waitFor", "selector": ".viewport__hud-reps" },
        { "do": "cmd", "text": "as cartoon" },
        { "do": "wait", "ms": 700 },
        { "do": "click", "selector": ".viewport__hud-rep button", "nth": 0 },
        { "do": "wait", "ms": 400 }
      ],
      "trigger": [{ "do": "click", "selector": ".viewport__hud-rep button", "nth": 1 }],
      "checks": [
        { "expect": "screenshotChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 600
    },

