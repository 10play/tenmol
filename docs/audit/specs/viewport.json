    {
      "id": "viewport.render.turn.y",
      "feature": "viewport",
      "label": "Viewport reflects camera turn (Y)",
      "kind": "other",
      "requires": [],
      "note": "A `turn y, 90` command rotates the PyMOL camera; the viewport must re-render the client-side geometry from the new view. This is the deterministic proxy for the free left-drag rotate gesture, which the audit DSL cannot script.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "as cartoon" },
        { "do": "wait", "ms": 500 }
      ],
      "trigger": [{ "do": "cmd", "text": "turn y, 90" }],
      "checks": [
        { "expect": "screenshotChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 500
    },
    {
      "id": "viewport.render.turn.x",
      "feature": "viewport",
      "label": "Viewport reflects camera turn (X)",
      "kind": "other",
      "requires": [],
      "note": "A `turn x, 90` command tilts the camera; the viewport must re-render from the new orientation.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "as cartoon" },
        { "do": "wait", "ms": 500 }
      ],
      "trigger": [{ "do": "cmd", "text": "turn x, 90" }],
      "checks": [
        { "expect": "screenshotChanged" },
        { "expect": "noConsoleError" }
      ],
      "settleMs": 500
    },
