      "id": "viewport.render.color",
      "feature": "viewport",
      "label": "Viewport reflects a recolor",
      "kind": "other",
      "requires": [],
      "note": "`color red, all` recolours the object; the client-side geometry must repaint with the new atom colours.",
      "needsVisual": false,
      "setup": [
        { "do": "cmd", "text": "as cartoon" },
        { "do": "wait", "ms": 500 }
      ],
      "trigger": [{ "do": "cmd", "text": "color red, all" }],
