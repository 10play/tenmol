{
  "area": "compute",
  "caps": ["local-backend", "webgl", "network"],
  "specs": [
    {
      "id": "compute.launcher.open",
      "feature": "compute",
      "label": "Overlay launcher ▸ Compute opens the panel",
      "kind": "toggle",
      "requires": [],
      "note": "The compute slot (registry order 90, region overlay) has no menu entry; it is reached only from the overlay-launcher ToggleButton (OverlayLauncher.tsx, icon Cpu, title 'Compute', class overlay-launcher__btn). Clicking it calls togglePanel('compute') which mounts the lazy FloatingWindow (data-testid compute-window).",
      "needsVisual": false,
      "setup": [],
      "trigger": [
        { "do": "click", "selector": ".overlay-launcher__btn[title=\"Compute\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"compute-window\"]", "ms": 3000 }
      ],
      "checks": [{ "check": "selectorVisible", "selector": "[data-testid=\"compute-window\"]" }],
      "settleMs": 500
    },
    {
      "id": "compute.window.close",
      "feature": "compute",
      "label": "Compute window ▸ close button",
      "kind": "button",
      "requires": [],
      "note": "FloatingWindow renders a close IconButton (title/aria-label 'close') that calls onClose -> closePanel('compute'), unmounting the slot.",
      "needsVisual": false,
      "setup": [
        { "do": "click", "selector": ".overlay-launcher__btn[title=\"Compute\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"compute-window\"]", "ms": 3000 }
      ],
      "trigger": [
        { "do": "click", "selector": "[data-testid=\"compute-window\"] button[title=\"close\"]" }
      ],
      "checks": [{ "check": "selectorHidden", "selector": "[data-testid=\"compute-window\"]" }],
      "settleMs": 500
    },
    {
      "id": "compute.window.shade",
      "feature": "compute",
      "label": "Compute window ▸ shade/restore (minimise) button",
      "kind": "toggle",
      "requires": [],
      "note": "FloatingWindow's shade button (title 'shade'/'restore') collapses the window to its title bar (minimised state), hiding the .compute body. domChanged catches the body content dropping out of the layout.",
      "needsVisual": false,
      "setup": [
        { "do": "click", "selector": ".overlay-launcher__btn[title=\"Compute\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"compute-window\"]", "ms": 3000 }
      ],
      "trigger": [
        { "do": "click", "selector": "[data-testid=\"compute-window\"] button[title=\"shade\"]" }
      ],
      "checks": [{ "check": "domChanged" }],
      "settleMs": 500
    },
    {
      "id": "compute.window.dragTitle",
      "feature": "compute",
      "label": "Compute window ▸ drag the title bar to move it",
      "kind": "drag",
      "requires": [],
      "note": "FloatingWindow .flwin__title has onPointerDown for drag-move (clamped on-screen, persisted under persistKey 'compute'). LIMITATION: the audit driver has no press-hold-move primitive, so the free drag cannot be reproduced; recorded with a plain click on the title bar and a no-error check as the closest observable.",
      "needsVisual": true,
      "setup": [
        { "do": "click", "selector": ".overlay-launcher__btn[title=\"Compute\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"compute-window\"]", "ms": 3000 }
      ],
      "trigger": [{ "do": "click", "selector": "[data-testid=\"compute-window\"] .flwin__title" }],
      "checks": [{ "check": "noPageError" }],
      "settleMs": 400
    },
    {
      "id": "compute.window.resize",
      "feature": "compute",
      "label": "Compute window ▸ resize grip",
      "kind": "drag",
      "requires": [],
      "note": "FloatingWindow .flwin__grip has onPointerDown for resize (min 320x320). LIMITATION: the driver cannot drag the grip; recorded with a hover on the grip and a no-error check as the closest observable.",
      "needsVisual": true,
      "setup": [
        { "do": "click", "selector": ".overlay-launcher__btn[title=\"Compute\"]" },
        { "do": "waitFor", "selector": "[data-testid=\"compute-window\"]", "ms": 3000 }
      ],
      "trigger": [{ "do": "hover", "selector": "[data-testid=\"compute-window\"] .flwin__grip" }],
      "checks": [{ "check": "noPageError" }],
      "settleMs": 400
    },
    {
      "id": "compute.selection.input",
      "feature": "compute",
      "label": "Selection box drives the metric call",
      "kind": "input",
      "requires": [],
      "note": "The shared selection TextInput (#cp-sel, default 'polymer') is passed as the selection arg of every helper via buildArgs. Typing a narrower selection and running Molecular surface area proves the value flows into util.get_area (result cell shows a number + Å²).",
      "needsVisual": false,
      "setup": [
        { "do": "click", "selector": ".overlay-launcher__btn[title=\"Compute\"]" },
        { "do": "waitFor", "selector": "#cp-sel", "ms": 3000 }
      ],
      "trigger": [
        { "do": "type", "selector": "#cp-sel", "text": "name CA" },
        { "do": "click", "selector": ".compute__table .compute__btn", "nth": 0 }
      ],
      "checks": [
        { "check": "feedbackMatches", "pattern": "Å" },
        { "check": "feedbackNotMatches", "pattern": "unavailable|cannot|unknown|error|exception" }
      ],
      "settleMs": 700
    },
