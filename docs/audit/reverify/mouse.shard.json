    {
      "id": "mouse.butmode.mode.cycle-forward",
      "feature": "mouse",
      "label": "ButMode mode line ▸ left-click cycles mode forward",
      "kind": "button",
      "requires": [],
      "note": "onMouseDown(cycleMode) with a plain left button issues cmd.mouse('forward'), stepping the ring; the printed mode name changes on re-read.",
      "setup": [
        {
          "do": "cmd",
          "text": "set internal_gui, 1"
        },
        {
          "do": "waitFor",
          "selector": "[data-testid=\"butmode\"]",
          "ms": 8000
        },
        {
          "do": "cmd",
          "text": "mouse three_button_viewing"
        },
        {
          "do": "wait",
          "ms": 500
        }
      ],
      "trigger": [
        {
          "do": "click",
          "selector": "[data-testid=\"butmode-mode\"]"
        },
        {
          "do": "wait",
          "ms": 500
        }
      ],
      "checks": [
        {
          "expect": "domChanged"
        },
        {
          "expect": "feedbackMatches",
          "pattern": "3-Button Editing"
        },
        {
          "expect": "noConsoleError"
        }
      ],
      "settleMs": 700
    },
    {
      "id": "mouse.butmode.selection.cycle-forward",
      "feature": "mouse",
      "label": "ButMode selection line ▸ left-click cycles level forward",
      "kind": "button",
      "requires": [],
      "note": "In a viewing mode single-left is not pkat, so the bottom line cycles: left-click issues cmd.mouse('select_forward'); from Molecules(5) it advances to C-alphas(6).",
      "setup": [
        {
          "do": "cmd",
          "text": "set internal_gui, 1"
        },
        {
          "do": "waitFor",
          "selector": "[data-testid=\"butmode\"]",
          "ms": 8000
        },
        {
          "do": "cmd",
          "text": "mouse three_button_viewing"
        },
        {
          "do": "cmd",
          "text": "set mouse_selection_mode, 5"
        },
        {
          "do": "wait",
          "ms": 500
        }
      ],
      "trigger": [
        {
          "do": "click",
          "selector": "[data-testid=\"butmode-selection\"]"
        },
        {
          "do": "wait",
          "ms": 500
        }
      ],
