{
  "area": "chrome",
  "caps": [
    "local-backend",
    "webgl",
    "network"
  ],
  "specs": [
    {
      "id": "chrome.launcher.volume",
      "feature": "shell",
      "label": "Panel launcher ▸ Volume",
      "kind": "toggle",
      "requires": [],
      "note": "Launcher toggle for the volume overlay slot.",
      "needsVisual": false,
      "setup": [
        {
          "do": "waitFor",
          "selector": ".overlay-launcher__btn[title=\"Volume\"]"
        }
      ],
      "trigger": [
        {
          "do": "click",
          "selector": ".overlay-launcher__btn[title=\"Volume\"]"
        }
      ],
      "checks": [
        {
          "expect": "domChanged"
        },
        {
          "expect": "noConsoleError"
        }
      ],
      "settleMs": 700
    },
    {
