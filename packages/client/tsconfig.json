{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite consumes src/ directly; this package is never built. Turning off
    // composite/declaration output keeps `noEmit` legal here.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
