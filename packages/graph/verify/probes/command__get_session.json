{
  "id": "command__get_session",
  "feature": "get_session",
  "kind": "command",
  "probeKind": "state",
  "ops": [
    { "do": "load ${REPO}/packages/engine/test/dat/1tii.pdb, m" },
    { "call": ["save", "/tmp/tenmol_get_session_rt.pse"] },
