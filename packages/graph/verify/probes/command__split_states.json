{
  "id": "command__split_states",
  "feature": "split_states",
  "kind": "command",
  "probeKind": "state",
  "ops": [
    { "do": "fragment ala" },
    { "do": "create multi, ala, 1, 1" },
    { "do": "create multi, ala, 1, 2" },
    { "do": "create multi, ala, 1, 3" },
    { "do": "split_states multi, prefix=part" }
  ],
  "checks": [
    { "call": ["count_states", "part0001"], "label": "first split object exists and is single-state" },
    { "call": ["count_states", "part0002"], "label": "second split object exists and is single-state" },
    { "call": ["count_states", "part0003"], "label": "third split object exists and is single-state" },
    { "call": ["count_states", "multi"], "label": "source object still has all 3 states" }
  ],
  "tol": 1e-3,
  "expected": [
    1,
    1,
    1,
    3
  ]
}
