{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite consumes src/ directly; this package is never built by tsc.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts", "packages/engine/test/**/*.ts"]
}
