# pnpm settings for the tenmol monorepo root.
# Node 22 + pnpm 9 (see "engines" / "packageManager" in package.json).

# Workspace packages always resolve to the local source, never to a registry copy.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Peer handling: install peers automatically, but do not hard-fail the whole install on a
# peer range mismatch (React 19 / three.js ecosystems still ship stale peer ranges).
auto-install-peers=true
strict-peer-dependencies=false
dedupe-peer-dependents=true

# Prefer the newest version allowed by every range, so two packages asking for the same
# library end up on one copy.
resolution-mode=highest

# Allow pre/post script hooks (pnpm disables them by default; codegen packages use them).
enable-pre-post-scripts=true
